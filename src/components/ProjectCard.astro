---
interface Props {
  index: number;
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  demo?: string;
  code?: string;
}

const { index, slug, title, summary, tags, demo, code } = Astro.props;
const label = `PROJECT_${String(index).padStart(2, '0')}`;
---
<div class="project-card">
    <div class="project-header">
        <div class="project-dots">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <span class="project-label">{label}</span>
    </div>
    <div class="project-content">
        <h3><a href={`/projects/${slug}/`} class="project-title-link">{title}</a></h3>
        <p>{summary}</p>
        <div class="project-tags">
            {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="project-links">
            <a href={`/projects/${slug}/`} class="project-link">
                <span class="link-code">&gt;</span> DETAILS
            </a>
            {demo && (
              <a href={demo} class="project-link" target="_blank" rel="noopener noreferrer">
                  <span class="link-code">&gt;</span> LIVE_DEMO
              </a>
            )}
            {code && (
              <a href={code} class="project-link" target="_blank" rel="noopener noreferrer">
                  <span class="link-code">&gt;</span> CODE
              </a>
            )}
        </div>
    </div>
</div>
