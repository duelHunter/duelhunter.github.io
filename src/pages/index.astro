---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Lahiru Senarathna | AI Automation Engineer" home>
    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="grid-overlay"></div>
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <div class="system-status">
                        <span class="status-indicator"></span>
                        <span class="status-text">SYSTEM ONLINE</span>
                    </div>
                    <h1 class="hero-title">
                        <span class="hero-name" id="typingText"></span>
                        <span class="cursor-blink">_</span>
                    </h1>
                    <p class="hero-subtitle has-tagline">AI Automation Engineer</p>
                    <p class="hero-tagline">DevOps | Cyber Security | Networking Enthusiast</p>
                    <div class="hero-description">
                        <p>Passionate developer creating innovative solutions to real-world challenges.</p>
                        <p>Specialized in full-stack development, automation, and building scalable applications.</p>
                    </div>
                    <div class="hero-buttons">
                        <a href="#projects" class="btn btn-primary">VIEW_WORK</a>
                        <a href="#contact" class="btn btn-secondary">CONTACT</a>
                    </div>
                    <div class="social-links">
                        <a href="https://www.linkedin.com/in/99xdilshan/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
                            <i class="fab fa-linkedin"></i>
                        </a>
                        <a href="https://fb.com/profile.php?id=100011263772662" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-link">
                            <i class="fab fa-facebook"></i>
                        </a>
                        <a href="https://github.com/duelhunter" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
                            <i class="fab fa-github"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <a href="#about">
                <span class="scroll-text">SCROLL</span>
                <i class="fas fa-chevron-down"></i>
            </a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">
                <span class="section-code">[02]</span> ABOUT_ME
            </h2>
            <div class="about-content">
                <div class="about-text-box">
                    <p>I'm a dedicated developer with a passion for solving complex problems and building innovative solutions. My journey in technology has led me to work with various technologies and frameworks, always focusing on creating efficient, scalable, and user-friendly applications.</p>
                    <p>Whether it's developing full-stack web applications, automating processes, or working with embedded systems, I approach each project with enthusiasm and attention to detail.</p>
                </div>
                <div class="about-stats">
                    <div class="stat-item">
                        <div class="stat-code">50+</div>
                        <p>PROJECTS_COMPLETED</p>
                    </div>
                    <div class="stat-item">
                        <div class="stat-code">3+</div>
                        <p>YEARS_EXPERIENCE</p>
                    </div>
                    <div class="stat-item">
                        <div class="stat-code">100%</div>
                        <p>CLIENT_SATISFACTION</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="skills">
        <div class="container">
            <h2 class="section-title">
                <span class="section-code">[03]</span> SKILLS_&_TECHNOLOGIES
            </h2>
            <div class="skills-grid">
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-python"></i></div>
                    <h3>Python</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-js"></i></div>
                    <h3>JavaScript</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-react"></i></div>
                    <h3>React</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-node-js"></i></div>
                    <h3>Node.js</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-html5"></i></div>
                    <h3>HTML5</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-css3-alt"></i></div>
                    <h3>CSS3</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-bootstrap"></i></div>
                    <h3>Bootstrap</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-git-alt"></i></div>
                    <h3>Git</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-linux"></i></div>
                    <h3>Linux</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-database"></i></div>
                    <h3>MongoDB</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-database"></i></div>
                    <h3>MySQL</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-figma"></i></div>
                    <h3>Figma</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-flask"></i></div>
                    <h3>Flask</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fab fa-python"></i></div>
                    <h3>Django</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-server"></i></div>
                    <h3>Express</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-code"></i></div>
                    <h3>C++</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-microchip"></i></div>
                    <h3>Arduino</h3>
                </div>
                <div class="skill-card">
                    <div class="skill-icon"><i class="fas fa-paint-brush"></i></div>
                    <h3>Photoshop</h3>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects">
        <div class="container">
            <h2 class="section-title">
                <span class="section-code">[04]</span> FEATURED_PROJECTS
            </h2>
            <div class="projects-grid">
                {featured.map((p, i) => (
                  <ProjectCard
                    index={i + 1}
                    slug={p.id}
                    title={p.data.title}
                    summary={p.data.summary}
                    tags={p.data.tags}
                    demo={p.data.demo}
                    code={p.data.code}
                    store={p.data.store}
                  />
                ))}
            </div>
            <div class="projects-more">
                <a href="/projects/" class="btn btn-primary">SHOW_MORE</a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <h2 class="section-title">
                <span class="section-code">[05]</span> GET_IN_TOUCH
            </h2>
            <div class="contact-content">
                <div class="contact-info">
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h3>EMAIL</h3>
                            <a href="mailto:99xdilshan@gmail.com">99xdilshan@gmail.com</a>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fab fa-linkedin"></i>
                        </div>
                        <div class="contact-details">
                            <h3>LINKEDIN</h3>
                            <a href="https://www.linkedin.com/in/99xdilshan/" target="_blank" rel="noopener noreferrer">Connect with me</a>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <i class="fab fa-facebook"></i>
                        </div>
                        <div class="contact-details">
                            <h3>FACEBOOK</h3>
                            <a href="https://fb.com/profile.php?id=100011263772662" target="_blank" rel="noopener noreferrer">Visit my profile</a>
                        </div>
                    </div>
                </div>
                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label class="form-label">NAME</label>
                        <input type="text" id="name" name="name" placeholder="Enter your name" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">EMAIL</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">MESSAGE</label>
                        <textarea id="message" name="message" rows="5" placeholder="Enter your message" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">SEND_MESSAGE</button>
                </form>
            </div>
        </div>
    </section>

</BaseLayout>
