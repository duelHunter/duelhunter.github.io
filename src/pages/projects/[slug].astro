---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, demo, code } = project.data;
---
<BaseLayout title={`${title} | Lahiru Senarathna`} description={summary} active="projects">
    <section class="project-detail">
        <div class="container">
            <a href="/projects/" class="btn btn-secondary back-link">&lt; ALL_PROJECTS</a>
            <h1 class="detail-title">{title}</h1>
            <p class="detail-summary">{summary}</p>
            <div class="project-tags">
                {tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <div class="project-links detail-links">
                {demo && (
                  <a href={demo} class="project-link" target="_blank" rel="noopener noreferrer">
                      <span class="link-code">&gt;</span> LIVE_DEMO
                  </a>
                )}
                {code && (
                  <a href={code} class="project-link" target="_blank" rel="noopener noreferrer">
                      <span class="link-code">&gt;</span> CODE
                  </a>
                )}
            </div>
            <article class="prose">
                <Content />
            </article>
        </div>
    </section>
</BaseLayout>
